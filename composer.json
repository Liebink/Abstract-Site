{
  "name": "lesname/abstract-site",
  "license": "MIT",
  "require": {
    "php": "^8.5.0",

    "ext-pdo": "*",

    "psr/http-server-middleware": "^1.0.0",

    "lesname/database": "^0.5.0",
    "lesname/domain": "^0.7.0",

    "slim/slim": "^4.14.0",
    "slim/psr7": "^1.6.0",
    "slim/twig-view": "^3.4.0",

    "twig/twig": "^3.21.0"
  },
  "autoload": {
    "psr-4": {
      "LesAbstractSite\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LesAbstractSiteTest\\": "src/"
    }
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^4.0.0",

    "phpunit/phpunit": "^13.0.0",

    "vimeo/psalm": "^7.0.0-beta9",

    "phpstan/phpstan": "^2.3.x-dev",
    "phpstan/extension-installer": "^1.4.0",
    "phpstan/phpstan-deprecation-rules": "^2.0.0"
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
